<?xml version="1.0" encoding="utf-8"?>
<!-- Widget animato: globo fermo, si anima solo la luce (onde sulle connessioni, nuclei che pulsano).
     16 fotogrammi x 200 ms = 3,2 s, dissolvenza incrociata. Tutti i fotogrammi sono visibili: un figlio nascosto lascerebbe un vuoto nel ciclo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/g_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo">
    <ViewFlipper android:id="@+id/g_flip" android:layout_width="match_parent" android:layout_height="match_parent"
        android:autoStart="true" android:flipInterval="200"
        android:inAnimation="@anim/globo_in" android:outAnimation="@anim/globo_out">
        <ImageView android:id="@+id/g_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f11" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f12" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f13" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f14" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
        <ImageView android:id="@+id/g_f15" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Globo delle connessioni di Second Brain" />
    </ViewFlipper>
    <TextView android:id="@+id/g_vuoto" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="12dp" android:textColor="#98A0C8" android:textSize="12sp"
        android:text="Apri Second Brain per disegnare il globo" />
</FrameLayout>
