<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_sfondo">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nome_app" android:textColor="#E6E8EB" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_piu" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="+" android:textColor="#17131F" android:textSize="22sp" android:background="@drawable/widget_piu" android:contentDescription="Aggiunta rapida" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_inbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E07A8A" android:textSize="20sp" android:textStyle="bold" android:text="0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9AA1AB" android:textSize="12sp" android:text="Da organizzare" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_progetti" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A78BFA" android:textSize="20sp" android:textStyle="bold" android:text="0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9AA1AB" android:textSize="12sp" android:text="Progetti attivi" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_attesa_box" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_attesa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E0A64F" android:textSize="20sp" android:textStyle="bold" android:text="0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9AA1AB" android:textSize="12sp" android:text="Attendono te" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_nota" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#9AA1AB" android:textSize="11sp" android:text="Nessuna rilevazione degli agenti" />
</LinearLayout>
